{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path(.*)", "destination": "/api/index?__path=:path" }
  ],
  "functions": {
    "api/index.js": { "maxDuration": 30 }
  }
}
